{
  "framework": "nextjs",
  "buildCommand": "pnpm run build",
  "installCommand": "pnpm install",
  "functions": {
    "app/api/**/*": {
      "maxDuration": 60
    },
    "app/api/visita/generate-pdf/route.ts": {
      "maxDuration": 90,
      "memory": 2048
    },
    "app/api/nota-encargo/generate-pdf/route.ts": {
      "maxDuration": 90,
      "memory": 2048
    },
    "app/api/puppet/generate-pdf/route.ts": {
      "maxDuration": 90,
      "memory": 2048
    }
  },
  "crons": [
    {
      "path": "/api/cron/notifications",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/briefings",
      "schedule": "0 7,8 * * *"
    },
    {
      "path": "/api/cron/fotocasa-leads",
      "schedule": "0 */2 * * *"
    }
  ]
}